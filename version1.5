task.spawn(function()
	for i = 1, 12 do
		local t = i / 12
		frame.BackgroundTransparency = 1 - (t * 0.9)
		title.TextTransparency = 1 - t
		message.TextTransparency = 1 - t
		shadow.ImageTransparency = 0.65 * (1 - t) + 0.02
		task.wait(0.02)
	end
end)
